#!/usr/bin/env python3
"""hive — talk to the running Hive app on this machine (butler API).

  ./hive pending                     (what waits for the owner)
  ./hive agents [--project NAME]
  ./hive tail  (--id AGENT_ID | [--project NAME] --agent NAME) [-n 10]
  ./hive send  (--id AGENT_ID | [--project NAME] --agent NAME) TEXT...
  ./hive start (--id AGENT_ID | [--project NAME] --agent NAME) [--mode resume|new]
  ./hive dismiss (--id AGENT_ID | [--project NAME] --agent NAME)   (stop waiting on a question for the owner)
  ./hive chat-search --q "words"
  ./hive feishu chats NAME...                         (find a chat or person; Feishu through Prime)
  ./hive feishu messages --chat CHAT_ID [-n 20]
  ./hive feishu send (--chat CHAT_ID | --to OPEN_ID) [--reply MESSAGE_ID] TEXT...   (sent as the owner)
  ./hive feishu people NAME...                        (company directory: someone never chatted with)
  ./hive feishu edit MESSAGE_ID TEXT... | ./hive feishu recall MESSAGE_ID   (what Hive sent, last 24h)
  ./hive feishu doc URL                               (a docx / wiki page as text)
  ./hive feishu-try --text "message" [--sender OPEN_ID] [--chat CHAT_ID]   (nothing is sent)
"""
import argparse, json, os, subprocess, sys, urllib.error, urllib.parse, urllib.request

HIVE_DIR = os.environ.get('HIVE_DATA_DIR') or os.path.expanduser('~/.hive')


def read(name):
    try:
        with open(os.path.join(HIVE_DIR, name)) as f:
            return f.read().split()[0]
    except (OSError, IndexError):
        return ''


def not_running():
    """No port.lock: say whether the Hive app is in fact open (a lock bug) or closed."""
    try:
        pids = subprocess.run(['pgrep', '-x', 'Hive'], capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        pids = []
    log = os.path.join(HIVE_DIR, 'port-lock.log')
    if pids:
        return (f'Hive is open (pid {", ".join(pids)}) but ~/.hive/port.lock is missing, so Butler cannot reach it. '
                f'Quit Hive (Cmd+Q) and open it again; please send {log} to the Hive team.')
    return 'Hive is not running (no ~/.hive/port.lock): the Hive app is closed on this Mac. Open Hive and try again.'


def call(method, path, body=None, timeout=200):
    port = read('port.lock')
    if not port:
        sys.exit(not_running())
    req = urllib.request.Request(
        f'http://127.0.0.1:{port}{path}', method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Content-Type': 'application/json', 'X-Hive-Token': read('api-token'),
                 # Set by Hive for a run answering someone: limits chat-search to chats they are in.
                 **({'X-Hive-Run': os.environ['HIVE_RUN_TOKEN']} if os.environ.get('HIVE_RUN_TOKEN') else {})})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            if e.code == 404:
                sys.exit('This Hive build has no butler API (needs v2.22.0 or newer).')
            if e.code == 401:
                sys.exit('Hive rejected the token (~/.hive/api-token). Is Hive v2.22.0+ running?')
            sys.exit(f'Hive answered HTTP {e.code}.')
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f'Cannot reach Hive on port {port}: {e}. Is the app open?')


def row(a):
    return f"{a['project']} / {a['agent']}  [{a['activity']}]  {a['role']}{'  · ' + a['note'] if a['note'] else ''}  (id {a['agentId']})"


def target(args):
    t = {}
    if args.id: t['agentId'] = args.id
    if args.project: t['project'] = args.project
    if args.agent: t['agent'] = args.agent
    if not t.get('agentId') and not t.get('agent'):
        sys.exit('Say which agent: --id AGENT_ID, or --agent NAME (plus --project NAME if the name repeats).')
    return t


def fail(status, data):
    err = data.get('error', f'HTTP {status}')
    msg = {
        'not_found': 'No agent with exactly that name / id.',
        'ambiguous': 'More than one agent has that name — pick one:',
        'signed_out': 'Feishu is not signed in to Hive. Ask the owner to sign in: Butler › Settings › Feishu.',
        'no_such_chat': 'No chat with that id among the owner\'s chats. Find it with ./hive feishu chats NAME.',
        'not_in_a_run': 'Not available while answering someone.',
        'missing_scope': 'Prime is not allowed to do that yet: the owner signs out of Feishu in Hive and in again (the Prime app needs the permission).',
        'too_old': 'Only what Hive sent in the last 24 hours can be changed.',
        'already_recalled': 'That message was recalled already.',
        'unsupported_link': 'Only Feishu docx and wiki document links can be read.',
        'bad_message': 'That is not a message id (om_…). See ./hive feishu messages --chat CHAT_ID.',
        'bad_chat': 'That is not a chat id (oc_…). Find it with ./hive feishu chats NAME.',
        'no_session': "That agent's chat is not running. Nothing was sent. Start it first (./hive start ...).",
        'not_in_print_mode': "That chat is in remote-control mode right now and can't take input.",
        'start_timeout': 'The chat did not come up within 3 minutes (it may still be compacting). Check again with ./hive agents.',
        'no_window': 'Hive has no window to start the chat in.',
        'empty_text': 'Nothing to send.',
        'busy': 'That agent is in the middle of a task; stopping it now would cut it off. Ask the owner, then add --force.',
        'no_such_card': 'No card with that id (or the prefix matches more than one). See ./hive cards --all.',
        'needs_owner_answer': 'That card is waiting for the owner\'s answer; it has no draft to edit.',
        'not_pending': 'That card is no longer waiting (sent or closed already).',
        'not_closed': 'Only a closed (dismissed) card can be reopened.',
        'why_required': 'Say why it can be closed: --why "…"',
        'bad_token': 'Hive rejected the token (~/.hive/api-token). Try again; if it persists, restart Hive.',
    }.get(err, err)
    print(f'FAILED: {msg}')
    for c in data.get('candidates') or []:
        print('  ' + row(c))
    sys.exit(1)


def main():
    p = argparse.ArgumentParser(prog='hive')
    sub = p.add_subparsers(dest='cmd', required=True)
    a = sub.add_parser('agents'); a.add_argument('--project'); a.add_argument('--detail', action='store_true')
    asg = sub.add_parser('assign'); asg.add_argument('task', nargs='+'); asg.add_argument('--agent', required=True); asg.add_argument('--project')
    asg.add_argument('--why', default=''); asg.add_argument('--confident', choices=['yes', 'no'], default='no'); asg.add_argument('--todo'); asg.add_argument('--alt', action='append', default=[])
    sub.add_parser('tasks')
    tk = sub.add_parser('task'); tk.add_argument('what', choices=['accept', 'back']); tk.add_argument('id'); tk.add_argument('note', nargs='*')
    nf = sub.add_parser('nofit'); nf.add_argument('todo'); nf.add_argument('--why', default='')
    sub.add_parser('pending')
    cs = sub.add_parser('cards'); cs.add_argument('--all', action='store_true')
    cal = sub.add_parser('calendar'); cal.add_argument('when', nargs='?', default='today'); cal.add_argument('--days', type=int, default=1)
    cd = sub.add_parser('card'); cd.add_argument('what', choices=['show', 'edit', 'close', 'reopen']); cd.add_argument('id')
    cd.add_argument('--draft'); cd.add_argument('--why')
    t = sub.add_parser('todo'); t.add_argument('what', choices=['add', 'list', 'done', 'drop', 'note', 'pri']); t.add_argument('args', nargs='*')
    t.add_argument('--due'); t.add_argument('--ref'); t.add_argument('--pri', type=int, choices=[1, 2, 3], default=2); t.add_argument('--all', action='store_true')
    j = sub.add_parser('jira'); j.add_argument('what', choices=['search', 'get', 'transitions', 'me']); j.add_argument('arg', nargs='?', default='')
    j.add_argument('--fields', default='summary,status,assignee,updated,labels,fixVersions,issuelinks'); j.add_argument('--max', type=int, default=20)
    r = sub.add_parser('run'); r.add_argument('routine', choices=['jira', 'jira-check', 'sort-inbox', 'morning-plan', 'evening-report', 'dispatch'])
    c = sub.add_parser('chat-search'); c.add_argument('--q', required=True)
    fs = sub.add_parser('feishu'); fs.add_argument('what', choices=['chats', 'messages', 'send', 'people', 'edit', 'recall', 'doc']); fs.add_argument('words', nargs='*')
    fs.add_argument('--chat'); fs.add_argument('--to'); fs.add_argument('--reply'); fs.add_argument('-n', type=int, default=20)
    f = sub.add_parser('feishu-try'); f.add_argument('--text', required=True); f.add_argument('--sender'); f.add_argument('--chat')
    for name in ('tail', 'send', 'start', 'stop', 'dismiss'):
        s = sub.add_parser(name)
        s.add_argument('--id'); s.add_argument('--project'); s.add_argument('--agent')
        if name == 'stop': s.add_argument('--force', action='store_true')
        if name == 'tail': s.add_argument('-n', type=int, default=10)
        if name == 'send': s.add_argument('text', nargs='+')
        if name == 'start': s.add_argument('--mode', choices=['resume', 'new'], default='resume')
    # `feishu send --chat ID text…`: the text may come after the options.
    args, extra = p.parse_known_args()
    if extra and args.cmd == 'feishu' and not any(x.startswith('-') for x in extra): args.words += extra
    elif extra: p.error('unrecognized arguments: ' + ' '.join(extra))

    if args.cmd == 'assign':
        status, data = call('POST', '/dispatch/assign', {'task': ' '.join(args.task), 'agent': args.agent, 'project': args.project, 'why': args.why,
                                                         'confident': args.confident == 'yes', 'todoId': args.todo, 'alternatives': args.alt}, timeout=120)
        if status != 200 or not data.get('ok'):
            if data.get('error') == 'ambiguous':
                print('FAILED: more than one agent has that name — add --project:')
                for c in data.get('candidates') or []: print('  ' + row(c))
                sys.exit(1)
            fail(status, {'error': {'no_such_agent': 'No agent with that name.', 'empty_task': 'Say what the task is.', 'no_such_todo': 'No todo with that id.',
                                    'send_failed': f"Could not reach the agent: {data.get('detail', '')}"}.get(data.get('error'), data.get('error', ''))})
        a = data['agent']
        print(f"ASKED THE OWNER: Assign card in Approve → {a['project']} / {a['agent']}. Nothing is sent until the owner presses Assign (they can add requirements). Tell them in one line.")
        return

    if args.cmd == 'tasks':
        status, data = call('GET', '/tasks')
        if status != 200: fail(status, data)
        rows = data['tasks']
        if not rows: print('No tasks with agents.'); return
        say = {'sent': 'sent', 'working': 'working', 'needs_you': 'WAITING FOR THE OWNER', 'blocked': 'BLOCKED', 'check': 'SAYS DONE — owner to check',
               'quiet': 'stopped without a report', 'stalled': 'no word for hours', 'closed': 'closed'}
        for x in rows:
            print(f"{x['tag']}  {x['agent']} ({x['project'] or '—'}) · {say.get(x['state'], x['state'])} · {x['title']}" + (f"\n      {x['text']}" if x['text'] else ''))
        return

    if args.cmd == 'task':
        note = ' '.join(args.note).strip()
        if args.what == 'back' and not note: sys.exit('Say what is still missing: ./hive task back <#tag> "…"')
        status, data = call('POST', f"/tasks/{args.what}", {'id': args.id, 'note': note}, timeout=120)
        if status != 200 or not data.get('ok'):
            fail(status, {'error': {'no_such_task': 'No such task (see ./hive tasks).', 'already_closed': 'That task is already closed.', 'empty_note': 'Say what is still missing.'}.get(data.get('error'), data.get('error', ''))})
        print('Closed: the owner accepted it.' if args.what == 'accept' else 'Sent back to the agent with what is missing.')
        return

    if args.cmd == 'nofit':
        status, data = call('POST', '/dispatch/nofit', {'todoId': args.todo, 'why': args.why})
        if status != 200: fail(status, data)
        print('Noted on the todo: no agent fits. Tell the owner.')
        return

    if args.cmd == 'agents':
        status, data = call('GET', '/agents' + ('?detail=1' if args.detail else ''))
        if status != 200: fail(status, data)
        rows = [x for x in data['agents'] if not args.project or x['project'] == args.project]
        order = {'working': 0, 'waiting': 1, 'off': 2}
        for x in sorted(rows, key=lambda x: (order[x['activity']], x['project'], x['agent'])):
            print(row(x))
            if args.detail and x.get('lastTask'): print(f"      last task: {x['lastTask']}")
        n = {k: sum(1 for x in rows if x['activity'] == k) for k in order}
        print(f"-- {len(rows)} agents: {n['working']} working, {n['waiting']} waiting (chat open, idle), {n['off']} off")
        return

    if args.cmd == 'todo':
        if args.what == 'list':
            status, data = call('GET', '/todos' + ('?all=1' if args.all else ''))
            if status != 200: fail(status, data)
            rows = data['todos']
            if not rows: print('No open todos.'); return
            for x in rows:
                pri = {1: '⚡要命 ', 3: '🧊冻着 '}.get(x.get('priority', 2), '')
                print(f"{x['id'][:8]}  {pri}{'[x] ' if x['status'] == 'done' else '[-] ' if x['status'] == 'dropped' else ''}{x['title']}{'  · due ' + x['due'] if x['due'] else ''}  ({x['source']}, {x['steps']} steps)")
            return
        if args.what == 'add':
            title = ' '.join(args.args).strip()
            status, data = call('POST', '/todos/add', {'title': title, 'due': args.due, 'ref': args.ref, 'priority': args.pri})
            if status != 200: fail(status, data)
            print(f"Noted {data['todo']['id'][:8]}: {data['todo']['title']}" + (f" (due {data['todo']['due']})" if data['todo']['due'] else ''))
            return
        if not args.args: sys.exit('Which todo? Give its id (from ./hive todo list).')
        tid, rest = args.args[0], ' '.join(args.args[1:])
        if args.what == 'note':
            status, data = call('POST', '/todos/note', {'id': tid, 'text': rest})
        elif args.what == 'pri':
            if rest.strip() not in ('1', '2', '3'): sys.exit('Priority 1 (⚡ 要命), 2 (🔥 冒烟) or 3 (🧊 冻着): ./hive todo pri <id> 1')
            status, data = call('POST', '/todos/priority', {'id': tid, 'priority': int(rest.strip())})
        else:
            status, data = call('POST', '/todos/status', {'id': tid, 'status': 'done' if args.what == 'done' else 'dropped'})
        if status != 200: fail(status, data)
        print({'note': 'Added to its history.', 'done': 'Done.', 'drop': 'Dropped.', 'pri': 'Priority set.'}[args.what])
        return

    if args.cmd == 'jira':
        tool, a = {
            'search': ('jira_search', {'jql': args.arg, 'fields': args.fields, 'max_results': args.max}),
            'get': ('jira_get_issue', {'issue_key': args.arg, 'fields': args.fields}),
            'transitions': ('jira_get_transitions', {'issue_key': args.arg}),
            'me': ('jira_get_user_profile', {}),
        }[args.what]
        status, data = call('POST', '/jira/read', {'tool': tool, 'args': a}, timeout=120)
        if status != 200: fail(status, data)
        print(data['result'])
        return

    if args.cmd == 'run':
        status, data = call('POST', '/routines/run', {'id': args.routine}, timeout=900)
        if status not in (200,): fail(status, data)
        run = data['run']
        print(f"{data['name']}: {'done' if run['ok'] else 'failed — ' + run.get('error', '')}")
        if data.get('text'): print(data['text'])
        return

    if args.cmd == 'calendar':
        import datetime
        w = args.when.strip().lower()
        today = datetime.date.today()
        day = {'today': today, '今天': today, 'tomorrow': today + datetime.timedelta(days=1), '明天': today + datetime.timedelta(days=1)}.get(w)
        if day is None:
            try: day = datetime.date.fromisoformat(w)
            except ValueError: sys.exit('Which day? today / tomorrow / YYYY-MM-DD, e.g. ./hive calendar 2026-10-30 --days 5')
        status, data = call('GET', f"/calendar?date={day.isoformat()}&days={max(1, min(14, args.days))}")
        if status != 200: fail(status, data)
        s = data['settings']
        if not s.get('feishu') and not s.get('mac'):
            print('No calendar is connected in Hive (Butler settings › Calendar).'); return
        why = {'signed_out': 'not signed in — Re-authorize Feishu in Butler settings', 'helper_missing': 'the Mac Calendar helper is missing'}
        hm = lambda ms: datetime.datetime.fromtimestamp(ms / 1000).strftime('%H:%M')
        for d in data['days']:
            print(f"{d['date']}:")
            for e in d['events']:
                when = 'all day' if e['allDay'] else f"{hm(e['start'])}–{hm(e['end'])}"
                print(f"  {when}  {e['title']}{'  @ ' + e['location'] if e.get('location') else ''}  [{e['source']}]")
            if not d['events']: print('  (nothing)')
            for src, err in (d.get('errors') or {}).items():
                print(f"  ⚠ {'Feishu' if src == 'feishu' else 'Mac Calendar'} could not be read: {why.get(err, err)}")
        return

    if args.cmd == 'cards':
        status, data = call('GET', '/cards' + ('?all=1' if args.all else ''))
        if status != 200: fail(status, data)
        if not data['cards']: print('No cards waiting.'); return
        for x in data['cards']:
            state = '' if x['status'] == 'pending' else f"[{x['status']}] "
            ask = f"  · asks: {x['question']}" if x['question'] else ''
            print(f"{x['id'][:8]}  {state}{x['title']}  ({x['subtitle']}){ask}")
        return

    if args.cmd == 'card':
        if args.what == 'show':
            status, data = call('GET', '/cards/show?id=' + urllib.parse.quote(args.id))
            if status != 200: fail(status, data)
            x = data['card']
            print(f"{x['id']}  {x['title']}  [{x['status']}]\n{x['subtitle']}")
            for label, key in (('They said', 'their'), ('What they want', 'about'), ('Already sent', 'sent'), ('Your call', 'topic'), ('Butler asks', 'question'), ('Draft', 'draft'), ('Link', 'url')):
                if x.get(key): print(f"\n{label}:\n{x[key]}")
            if x.get('closed'): print(f"\nClosed by {x['closed']['by']}" + (f": {x['closed'].get('why')}" if x['closed'].get('why') else ''))
            return
        if args.what == 'edit':
            if not args.draft: sys.exit('Give the new draft: ./hive card edit <id> --draft "…"')
            status, data = call('POST', '/cards/edit', {'id': args.id, 'draft': args.draft})
        elif args.what == 'close':
            if not args.why: sys.exit('Say why: ./hive card close <id> --why "…"')
            status, data = call('POST', '/cards/close', {'id': args.id, 'why': args.why})
        else:
            status, data = call('POST', '/cards/reopen', {'id': args.id})
        if status != 200: fail(status, data)
        print({'edit': 'Draft updated — the owner sends it from the card.', 'close': 'Closed (kept in History).', 'reopen': 'Back in Approve.'}[args.what])
        return

    if args.cmd == 'pending':
        status, data = call('GET', '/pending')
        if status != 200: fail(status, data)
        import time
        hm = lambda ms: time.strftime('%H:%M', time.localtime(ms / 1000))
        what = {'permission': 'asks permission', 'question': 'asks you', 'waiting': 'waiting for you'}
        agents, appr, failed = data['agents'], data['approvals'], data['routinesFailed']
        if not agents and not appr['count'] and not failed:
            print('Nothing waiting.')
            return
        if agents:
            print(f"Agents ({len(agents)}):")
            for x in agents:
                print(f"  {x['project']} / {x['agent']} — {what.get(x['state'], x['state'])} since {hm(x['since'])}{': ' + x['text'] if x['text'] else ''}  (id {x['agentId']})")
        if appr['count']:
            print(f"Approvals ({appr['count']}, in Hive › Butler › Approve):")
            for t in appr['titles'][:10]: print(f"  {t}")
        if failed:
            print(f"Failed routines today ({len(failed)}):")
            for r in failed: print(f"  {r['name']} at {hm(r['at'])}: {r['error']}")
        return

    if args.cmd == 'chat-search':
        from urllib.parse import urlencode
        status, data = call('GET', '/feishu/chat-search?' + urlencode({'q': args.q}))
        if status != 200: fail(status, data)
        if data.get('note'): print(f"({data['note']})")
        if not data['hits']: print('No messages found.')
        for h in data['hits']:
            print(f"[{h['chatName'] or h['chatId']} · {h['time']}] {h['text']}")
        return

    if args.cmd == 'feishu':
        from urllib.parse import urlencode
        hm = lambda ms: __import__('datetime').datetime.fromtimestamp(ms / 1000).strftime('%m-%d %H:%M')
        if args.what == 'chats':
            if not args.words: sys.exit('Say who or which chat: ./hive feishu chats 张三')
            status, data = call('GET', '/feishu/chats?' + urlencode({'q': ' '.join(args.words)}))
            if status != 200: fail(status, data)
            if not data['chats']: print('No chat with that name.')
            for c in data['chats']: print(f"{c['name']}  [{'direct' if c['p2p'] else 'group'}]  (chat {c['id']})")
            return
        if args.what == 'people':
            if not args.words: sys.exit('Say who: ./hive feishu people 张三')
            status, data = call('GET', '/feishu/people?' + urlencode({'q': ' '.join(args.words)}))
            if status != 200: fail(status, data)
            if not data['people']: print('Nobody with that name in the directory.')
            for u in data['people']: print(f"{u['name']}  (to {u['openId']})")
            return
        if args.what in ('edit', 'recall'):
            if not args.words: sys.exit(f'Which message? ./hive feishu {args.what} MESSAGE_ID' + (' TEXT' if args.what == 'edit' else ''))
            mid, text = args.words[0], ' '.join(args.words[1:]).strip()
            if args.what == 'edit' and not text: sys.exit('What should it say? ./hive feishu edit MESSAGE_ID TEXT')
            status, data = call('POST', f'/feishu/{args.what}', {'id': mid, **({'text': text} if args.what == 'edit' else {})})
            if data.get('error') == 'not_found': sys.exit('FAILED: No such message among what Hive sent (see the Feishu log in Butler).')
            if status != 200: fail(status, data)
            print('EDITED' if args.what == 'edit' else 'RECALLED')
            return
        if args.what == 'doc':
            if not args.words: sys.exit('Which document? ./hive feishu doc URL')
            status, data = call('GET', '/feishu/doc?' + urlencode({'url': args.words[0]}))
            if status != 200: fail(status, data)
            if data.get('title'): print(f"# {data['title']}\n")
            print(data['text'])
            return
        if not args.chat and not (args.what == 'send' and args.to): sys.exit('Which chat? --chat CHAT_ID (find it with ./hive feishu chats NAME, or --to OPEN_ID from ./hive feishu people)')
        if args.what == 'messages':
            status, data = call('GET', '/feishu/messages?' + urlencode({'chat': args.chat, 'n': args.n}))
            if status != 200: fail(status, data)
            for m in data['messages']: print(f"[{hm(m['time'])} · {'me' if m['mine'] else m['sender']}] {m['text']}  (msg {m['id']})")
            return
        text = ' '.join(args.words).strip()
        if not text: sys.exit('Nothing to send.')
        status, data = call('POST', '/feishu/send', {**({'chat': args.chat} if args.chat else {'to': args.to}), 'text': text, **({'replyTo': args.reply} if args.reply else {})})
        if status != 200: fail(status, data)
        print(f"SENT (msg {data['id']})")
        return

    if args.cmd == 'feishu-try':
        body = {'text': args.text, **({'senderId': args.sender} if args.sender else {}), **({'chatId': args.chat} if args.chat else {})}
        status, data = call('POST', '/feishu/try', body, timeout=600)
        if status != 200 or not data.get('ok'): fail(status, data)
        g = data['gate']
        print(f"{g['level'].upper()}  ({data['ms'] / 1000:.1f}s)  relation={data['relation']}  calendar={'yes' if data['calendarKnown'] else 'no'}")
        if g['reasons']: print('  why: ' + '; '.join(g['reasons']))
        a = data.get('answer') or {}
        print(f"  category={a.get('category')}  confidence={a.get('confidence')}  sources={', '.join(a.get('sources') or []) or '-'}")
        for c in a.get('claims') or []: print(f"  claim: {c['claim']} → {c['verdict']} ({c['source'] or 'no source'})")
        if data.get('error'): print(f"  error: {data['error']}")
        print(f"\nWould send: {data['wouldSend']}")
        if data['draft'] and data['draft'] != data['wouldSend']: print(f"Draft for the owner: {data['draft']}")
        return

    t = target(args)
    if args.cmd == 'tail':
        from urllib.parse import urlencode
        q = {**{k: v for k, v in t.items()}, 'n': args.n}
        status, data = call('GET', '/chat/tail?' + urlencode(q))
        if status != 200: fail(status, data)
        print(row(data['agent']))
        if not data['items']: print('(no chat log yet)')
        for i in data['items']:
            print(f"\n[{i['role']}] {i['text']}")
    elif args.cmd == 'send':
        text = ' '.join(args.text)
        status, data = call('POST', '/chat/send', {**t, 'text': text})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"SENT to {a['project']} / {a['agent']}: {text}")
        if data.get('queuedBehindRunningTurn'):
            print('(it is mid-turn; this message is queued behind the current turn)')
    elif args.cmd == 'stop':
        status, data = call('POST', '/chat/stop', {**t, 'force': args.force})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"{'ALREADY CLOSED' if data.get('alreadyStopped') else 'CLOSED'}: {a['project']} / {a['agent']}")

    elif args.cmd == 'dismiss':
        status, data = call('POST', '/chat/dismiss', t)
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"DISMISSED: {a['project']} / {a['agent']} is no longer waiting. Send your instructions with ./hive send.")

    elif args.cmd == 'start':
        status, data = call('POST', '/chat/start', {**t, 'mode': args.mode})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"{'ALREADY RUNNING' if data.get('alreadyRunning') else 'STARTED (' + args.mode + ')'}: {a['project']} / {a['agent']}")


if __name__ == '__main__':
    main()
