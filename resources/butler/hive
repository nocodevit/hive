#!/usr/bin/env python3
"""hive — talk to the running Hive app on this machine (butler API).

  ./hive agents [--project NAME]
  ./hive tail  (--id AGENT_ID | [--project NAME] --agent NAME) [-n 10]
  ./hive send  (--id AGENT_ID | [--project NAME] --agent NAME) TEXT...
  ./hive start (--id AGENT_ID | [--project NAME] --agent NAME) [--mode resume|new]
"""
import argparse, json, os, sys, urllib.error, urllib.request

HIVE_DIR = os.environ.get('HIVE_DATA_DIR') or os.path.expanduser('~/.hive')


def read(name):
    try:
        with open(os.path.join(HIVE_DIR, name)) as f:
            return f.read().split()[0]
    except (OSError, IndexError):
        return ''


def call(method, path, body=None, timeout=200):
    port = read('port.lock')
    if not port:
        sys.exit('Hive is not running (no ~/.hive/port.lock).')
    req = urllib.request.Request(
        f'http://127.0.0.1:{port}{path}', method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Content-Type': 'application/json', 'X-Hive-Token': read('api-token')})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            if e.code == 404:
                sys.exit('This Hive build has no butler API (needs v2.22.0 or newer).')
            if e.code == 401:
                sys.exit('Hive rejected the token (~/.hive/api-token). Is Hive v2.22.0+ running?')
            sys.exit(f'Hive answered HTTP {e.code}.')
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f'Cannot reach Hive on port {port}: {e}. Is the app open?')


def row(a):
    return f"{a['project']} / {a['agent']}  [{a['activity']}]  {a['role']}{'  · ' + a['note'] if a['note'] else ''}  (id {a['agentId']})"


def target(args):
    t = {}
    if args.id: t['agentId'] = args.id
    if args.project: t['project'] = args.project
    if args.agent: t['agent'] = args.agent
    if not t.get('agentId') and not t.get('agent'):
        sys.exit('Say which agent: --id AGENT_ID, or --agent NAME (plus --project NAME if the name repeats).')
    return t


def fail(status, data):
    err = data.get('error', f'HTTP {status}')
    msg = {
        'not_found': 'No agent with exactly that name / id.',
        'ambiguous': 'More than one agent has that name — pick one:',
        'no_session': "That agent's chat is not running. Nothing was sent. Start it first (./hive start ...).",
        'not_in_print_mode': "That chat is in remote-control mode right now and can't take input.",
        'start_timeout': 'The chat did not come up within 3 minutes (it may still be compacting). Check again with ./hive agents.',
        'no_window': 'Hive has no window to start the chat in.',
        'empty_text': 'Nothing to send.',
        'bad_token': 'Hive rejected the token (~/.hive/api-token). Try again; if it persists, restart Hive.',
    }.get(err, err)
    print(f'FAILED: {msg}')
    for c in data.get('candidates') or []:
        print('  ' + row(c))
    sys.exit(1)


def main():
    p = argparse.ArgumentParser(prog='hive')
    sub = p.add_subparsers(dest='cmd', required=True)
    a = sub.add_parser('agents'); a.add_argument('--project')
    for name in ('tail', 'send', 'start'):
        s = sub.add_parser(name)
        s.add_argument('--id'); s.add_argument('--project'); s.add_argument('--agent')
        if name == 'tail': s.add_argument('-n', type=int, default=10)
        if name == 'send': s.add_argument('text', nargs='+')
        if name == 'start': s.add_argument('--mode', choices=['resume', 'new'], default='resume')
    args = p.parse_args()

    if args.cmd == 'agents':
        status, data = call('GET', '/agents')
        if status != 200: fail(status, data)
        rows = [x for x in data['agents'] if not args.project or x['project'] == args.project]
        order = {'working': 0, 'waiting': 1, 'off': 2}
        for x in sorted(rows, key=lambda x: (order[x['activity']], x['project'], x['agent'])):
            print(row(x))
        n = {k: sum(1 for x in rows if x['activity'] == k) for k in order}
        print(f"-- {len(rows)} agents: {n['working']} working, {n['waiting']} waiting (chat open, idle), {n['off']} off")
        return

    t = target(args)
    if args.cmd == 'tail':
        from urllib.parse import urlencode
        q = {**{k: v for k, v in t.items()}, 'n': args.n}
        status, data = call('GET', '/chat/tail?' + urlencode(q))
        if status != 200: fail(status, data)
        print(row(data['agent']))
        if not data['items']: print('(no chat log yet)')
        for i in data['items']:
            print(f"\n[{i['role']}] {i['text']}")
    elif args.cmd == 'send':
        text = ' '.join(args.text)
        status, data = call('POST', '/chat/send', {**t, 'text': text})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"SENT to {a['project']} / {a['agent']}: {text}")
        if data.get('queuedBehindRunningTurn'):
            print('(it is mid-turn; this message is queued behind the current turn)')
    elif args.cmd == 'start':
        status, data = call('POST', '/chat/start', {**t, 'mode': args.mode})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"{'ALREADY RUNNING' if data.get('alreadyRunning') else 'STARTED (' + args.mode + ')'}: {a['project']} / {a['agent']}")


if __name__ == '__main__':
    main()
