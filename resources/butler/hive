#!/usr/bin/env python3
"""hive — talk to the running Hive app on this machine (butler API).

  ./hive pending                     (what waits for the owner)
  ./hive agents [--project NAME]
  ./hive tail  (--id AGENT_ID | [--project NAME] --agent NAME) [-n 10]
  ./hive send  (--id AGENT_ID | [--project NAME] --agent NAME) TEXT...
  ./hive start (--id AGENT_ID | [--project NAME] --agent NAME) [--mode resume|new]
  ./hive chat-search --q "words"
  ./hive feishu-try --text "message" [--sender OPEN_ID] [--chat CHAT_ID]   (nothing is sent)
"""
import argparse, json, os, subprocess, sys, urllib.error, urllib.request

HIVE_DIR = os.environ.get('HIVE_DATA_DIR') or os.path.expanduser('~/.hive')


def read(name):
    try:
        with open(os.path.join(HIVE_DIR, name)) as f:
            return f.read().split()[0]
    except (OSError, IndexError):
        return ''


def not_running():
    """No port.lock: say whether the Hive app is in fact open (a lock bug) or closed."""
    try:
        pids = subprocess.run(['pgrep', '-x', 'Hive'], capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        pids = []
    log = os.path.join(HIVE_DIR, 'port-lock.log')
    if pids:
        return (f'Hive is open (pid {", ".join(pids)}) but ~/.hive/port.lock is missing, so Butler cannot reach it. '
                f'Quit Hive (Cmd+Q) and open it again; please send {log} to the Hive team.')
    return 'Hive is not running (no ~/.hive/port.lock): the Hive app is closed on this Mac. Open Hive and try again.'


def call(method, path, body=None, timeout=200):
    port = read('port.lock')
    if not port:
        sys.exit(not_running())
    req = urllib.request.Request(
        f'http://127.0.0.1:{port}{path}', method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Content-Type': 'application/json', 'X-Hive-Token': read('api-token'),
                 # Set by Hive for a run answering someone: limits chat-search to chats they are in.
                 **({'X-Hive-Run': os.environ['HIVE_RUN_TOKEN']} if os.environ.get('HIVE_RUN_TOKEN') else {})})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            if e.code == 404:
                sys.exit('This Hive build has no butler API (needs v2.22.0 or newer).')
            if e.code == 401:
                sys.exit('Hive rejected the token (~/.hive/api-token). Is Hive v2.22.0+ running?')
            sys.exit(f'Hive answered HTTP {e.code}.')
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f'Cannot reach Hive on port {port}: {e}. Is the app open?')


def row(a):
    return f"{a['project']} / {a['agent']}  [{a['activity']}]  {a['role']}{'  · ' + a['note'] if a['note'] else ''}  (id {a['agentId']})"


def target(args):
    t = {}
    if args.id: t['agentId'] = args.id
    if args.project: t['project'] = args.project
    if args.agent: t['agent'] = args.agent
    if not t.get('agentId') and not t.get('agent'):
        sys.exit('Say which agent: --id AGENT_ID, or --agent NAME (plus --project NAME if the name repeats).')
    return t


def fail(status, data):
    err = data.get('error', f'HTTP {status}')
    msg = {
        'not_found': 'No agent with exactly that name / id.',
        'ambiguous': 'More than one agent has that name — pick one:',
        'no_session': "That agent's chat is not running. Nothing was sent. Start it first (./hive start ...).",
        'not_in_print_mode': "That chat is in remote-control mode right now and can't take input.",
        'start_timeout': 'The chat did not come up within 3 minutes (it may still be compacting). Check again with ./hive agents.',
        'no_window': 'Hive has no window to start the chat in.',
        'empty_text': 'Nothing to send.',
        'bad_token': 'Hive rejected the token (~/.hive/api-token). Try again; if it persists, restart Hive.',
    }.get(err, err)
    print(f'FAILED: {msg}')
    for c in data.get('candidates') or []:
        print('  ' + row(c))
    sys.exit(1)


def main():
    p = argparse.ArgumentParser(prog='hive')
    sub = p.add_subparsers(dest='cmd', required=True)
    a = sub.add_parser('agents'); a.add_argument('--project')
    sub.add_parser('pending')
    j = sub.add_parser('jira'); j.add_argument('what', choices=['search', 'get', 'transitions', 'me']); j.add_argument('arg', nargs='?', default='')
    j.add_argument('--fields', default='summary,status,assignee,updated,labels,fixVersions,issuelinks'); j.add_argument('--max', type=int, default=20)
    r = sub.add_parser('run'); r.add_argument('routine', choices=['jira', 'jira-check', 'sort-inbox', 'morning-plan', 'evening-report'])
    c = sub.add_parser('chat-search'); c.add_argument('--q', required=True)
    f = sub.add_parser('feishu-try'); f.add_argument('--text', required=True); f.add_argument('--sender'); f.add_argument('--chat')
    for name in ('tail', 'send', 'start'):
        s = sub.add_parser(name)
        s.add_argument('--id'); s.add_argument('--project'); s.add_argument('--agent')
        if name == 'tail': s.add_argument('-n', type=int, default=10)
        if name == 'send': s.add_argument('text', nargs='+')
        if name == 'start': s.add_argument('--mode', choices=['resume', 'new'], default='resume')
    args = p.parse_args()

    if args.cmd == 'agents':
        status, data = call('GET', '/agents')
        if status != 200: fail(status, data)
        rows = [x for x in data['agents'] if not args.project or x['project'] == args.project]
        order = {'working': 0, 'waiting': 1, 'off': 2}
        for x in sorted(rows, key=lambda x: (order[x['activity']], x['project'], x['agent'])):
            print(row(x))
        n = {k: sum(1 for x in rows if x['activity'] == k) for k in order}
        print(f"-- {len(rows)} agents: {n['working']} working, {n['waiting']} waiting (chat open, idle), {n['off']} off")
        return

    if args.cmd == 'jira':
        tool, a = {
            'search': ('jira_search', {'jql': args.arg, 'fields': args.fields, 'max_results': args.max}),
            'get': ('jira_get_issue', {'issue_key': args.arg, 'fields': args.fields}),
            'transitions': ('jira_get_transitions', {'issue_key': args.arg}),
            'me': ('jira_get_user_profile', {}),
        }[args.what]
        status, data = call('POST', '/jira/read', {'tool': tool, 'args': a}, timeout=120)
        if status != 200: fail(status, data)
        print(data['result'])
        return

    if args.cmd == 'run':
        status, data = call('POST', '/routines/run', {'id': args.routine}, timeout=900)
        if status not in (200,): fail(status, data)
        run = data['run']
        print(f"{data['name']}: {'done' if run['ok'] else 'failed — ' + run.get('error', '')}")
        if data.get('text'): print(data['text'])
        return

    if args.cmd == 'pending':
        status, data = call('GET', '/pending')
        if status != 200: fail(status, data)
        import time
        hm = lambda ms: time.strftime('%H:%M', time.localtime(ms / 1000))
        what = {'permission': 'asks permission', 'question': 'asks you', 'waiting': 'waiting for you'}
        agents, appr, failed = data['agents'], data['approvals'], data['routinesFailed']
        if not agents and not appr['count'] and not failed:
            print('Nothing waiting.')
            return
        if agents:
            print(f"Agents ({len(agents)}):")
            for x in agents:
                print(f"  {x['project']} / {x['agent']} — {what.get(x['state'], x['state'])} since {hm(x['since'])}{': ' + x['text'] if x['text'] else ''}  (id {x['agentId']})")
        if appr['count']:
            print(f"Approvals ({appr['count']}, in Hive › Butler › Approve):")
            for t in appr['titles'][:10]: print(f"  {t}")
        if failed:
            print(f"Failed routines today ({len(failed)}):")
            for r in failed: print(f"  {r['name']} at {hm(r['at'])}: {r['error']}")
        return

    if args.cmd == 'chat-search':
        from urllib.parse import urlencode
        status, data = call('GET', '/feishu/chat-search?' + urlencode({'q': args.q}))
        if status != 200: fail(status, data)
        if data.get('note'): print(f"({data['note']})")
        if not data['hits']: print('No messages found.')
        for h in data['hits']:
            print(f"[{h['chatName'] or h['chatId']} · {h['time']}] {h['text']}")
        return

    if args.cmd == 'feishu-try':
        body = {'text': args.text, **({'senderId': args.sender} if args.sender else {}), **({'chatId': args.chat} if args.chat else {})}
        status, data = call('POST', '/feishu/try', body, timeout=600)
        if status != 200 or not data.get('ok'): fail(status, data)
        g = data['gate']
        print(f"{g['level'].upper()}  ({data['ms'] / 1000:.1f}s)  relation={data['relation']}  calendar={'yes' if data['calendarKnown'] else 'no'}")
        if g['reasons']: print('  why: ' + '; '.join(g['reasons']))
        a = data.get('answer') or {}
        print(f"  category={a.get('category')}  confidence={a.get('confidence')}  sources={', '.join(a.get('sources') or []) or '-'}")
        for c in a.get('claims') or []: print(f"  claim: {c['claim']} → {c['verdict']} ({c['source'] or 'no source'})")
        if data.get('error'): print(f"  error: {data['error']}")
        print(f"\nWould send: {data['wouldSend']}")
        if data['draft'] and data['draft'] != data['wouldSend']: print(f"Draft for the owner: {data['draft']}")
        return

    t = target(args)
    if args.cmd == 'tail':
        from urllib.parse import urlencode
        q = {**{k: v for k, v in t.items()}, 'n': args.n}
        status, data = call('GET', '/chat/tail?' + urlencode(q))
        if status != 200: fail(status, data)
        print(row(data['agent']))
        if not data['items']: print('(no chat log yet)')
        for i in data['items']:
            print(f"\n[{i['role']}] {i['text']}")
    elif args.cmd == 'send':
        text = ' '.join(args.text)
        status, data = call('POST', '/chat/send', {**t, 'text': text})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"SENT to {a['project']} / {a['agent']}: {text}")
        if data.get('queuedBehindRunningTurn'):
            print('(it is mid-turn; this message is queued behind the current turn)')
    elif args.cmd == 'start':
        status, data = call('POST', '/chat/start', {**t, 'mode': args.mode})
        if status != 200 or not data.get('ok'): fail(status, data)
        a = data['agent']
        print(f"{'ALREADY RUNNING' if data.get('alreadyRunning') else 'STARTED (' + args.mode + ')'}: {a['project']} / {a['agent']}")


if __name__ == '__main__':
    main()
